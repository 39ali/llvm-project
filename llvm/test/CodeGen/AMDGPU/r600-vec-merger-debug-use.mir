# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=r600 -mcpu=cayman -run-pass=vec-merger -o - %s | FileCheck %s

# A DBG_VALUE use of a REG_SEQUENCE must not prevent it from being merged into
# or with another vector.

--- |
  define amdgpu_vs void @merge_without_debug_use() {
    ret void
  }

  define amdgpu_vs void @merge_with_debug_use_of_base() !dbg !3 {
    ret void
  }

  define amdgpu_vs void @merge_with_debug_use_of_merged() !dbg !9 {
    ret void
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "debugify", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "r600-vec-merger-debug-use.mir", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "merge_with_debug_use_of_base", linkageName: "merge_with_debug_use_of_base", scope: null, file: !1, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !5)
  !4 = !DISubroutineType(types: !5)
  !5 = !{}
  !6 = !DIBasicType(name: "ty128", size: 128, encoding: DW_ATE_unsigned)
  !7 = !DILocalVariable(name: "value", scope: !3, file: !1, line: 1, type: !6)
  !8 = !DILocation(line: 1, column: 1, scope: !3)
  !9 = distinct !DISubprogram(name: "merge_with_debug_use_of_merged", linkageName: "merge_with_debug_use_of_merged", scope: null, file: !1, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !5)
  !10 = !DILocalVariable(name: "value", scope: !9, file: !1, line: 1, type: !6)
  !11 = !DILocation(line: 1, column: 1, scope: !9)
...

---
name:            merge_without_debug_use
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: merge_without_debug_use
    ; CHECK: [[MOV:%[0-9]+]]:r600_reg32 = MOV 1, 0, 0, 0, $alu_const, 0, 0, 0, 2060, 1, $pred_sel_off, 0, 0
    ; CHECK-NEXT: [[MOV1:%[0-9]+]]:r600_reg32 = MOV 1, 0, 0, 0, $alu_const, 0, 0, 0, 2059, 1, $pred_sel_off, 0, 0
    ; CHECK-NEXT: [[MOV2:%[0-9]+]]:r600_reg32 = MOV 1, 0, 0, 0, $alu_const, 0, 0, 0, 2058, 1, $pred_sel_off, 0, 0
    ; CHECK-NEXT: [[MOV3:%[0-9]+]]:r600_reg32 = MOV 1, 0, 0, 0, $alu_const, 0, 0, 0, 2057, 1, $pred_sel_off, 0, 0
    ; CHECK-NEXT: [[REG_SEQUENCE:%[0-9]+]]:r600_reg128 = REG_SEQUENCE [[MOV2]], %subreg.sub0, [[MOV3]], %subreg.sub1, [[MOV1]], %subreg.sub2, [[MOV]], %subreg.sub3
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:r600_reg32 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:r600_reg32 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF2:%[0-9]+]]:r600_reg32 = IMPLICIT_DEF
    ; CHECK-NEXT: [[INSERT_SUBREG:%[0-9]+]]:r600_reg128 = INSERT_SUBREG [[REG_SEQUENCE]], [[MOV3]], %subreg.sub1
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:r600_reg128 = COPY [[INSERT_SUBREG]]
    ; CHECK-NEXT: EG_ExportSwz [[REG_SEQUENCE]], 0, 0, 0, 1, 2, 3, 83, 0
    ; CHECK-NEXT: EG_ExportSwz [[COPY]], 0, 1, 1, 4, 4, 4, 84, 1
    ; CHECK-NEXT: RETURN
    %0:r600_reg32 = MOV 1, 0, 0, 0, $alu_const, 0, 0, 0, 2060, 1, $pred_sel_off, 0, 0
    %1:r600_reg32 = MOV 1, 0, 0, 0, $alu_const, 0, 0, 0, 2059, 1, $pred_sel_off, 0, 0
    %2:r600_reg32 = MOV 1, 0, 0, 0, $alu_const, 0, 0, 0, 2058, 1, $pred_sel_off, 0, 0
    %3:r600_reg32 = MOV 1, 0, 0, 0, $alu_const, 0, 0, 0, 2057, 1, $pred_sel_off, 0, 0
    %4:r600_reg128 = REG_SEQUENCE %2, %subreg.sub0, %3, %subreg.sub1, %1, %subreg.sub2, %0, %subreg.sub3
    %6:r600_reg32 = IMPLICIT_DEF
    %7:r600_reg32 = IMPLICIT_DEF
    %8:r600_reg32 = IMPLICIT_DEF
    %5:r600_reg128 = REG_SEQUENCE %3, %subreg.sub0, %6, %subreg.sub1, %7, %subreg.sub2, %8, %subreg.sub3
    EG_ExportSwz %4, 0, 0, 0, 1, 2, 3, 83, 0
    EG_ExportSwz %5, 0, 1, 0, 4, 4, 4, 84, 1
    RETURN
...

